# Build output. Generated by `node ccstats.mjs`, and it inlines your own usage numbers —
# day-by-day token counts, message counts, estimated spend. Nothing identifying (no paths,
# no project names, no message content), but it is still your data, so it stays local.
ccstats.html
*.ccstats.html

# Local config: may point at custom transcript folders on your machine.
ccstats.config.json

# Exported data
data.json
ccstats-data.json

# Release build output (tools/bundle.mjs, and the artifacts the workflow assembles)
dist/
pkg/
ccstats-v*.zip
NOTES.md
ccstats.rb
ccstats.json
*.tgz

node_modules/
.DS_Store
Thumbs.db
desktop.ini
